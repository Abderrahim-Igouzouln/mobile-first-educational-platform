generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  guest
  student
  instructor
  moderator
  admin
  superadmin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum QuestionType {
  mcq
  true_false
  fill_blank
}

enum Level {
  beginner
  intermediate
  advanced
}

enum ProgressStatus {
  not_started
  in_progress
  completed
}

enum SubmissionStatus {
  submitted
  in_review
  approved
  rejected
}

enum BillingInterval {
  monthly
  annual
  none
}

enum SubStatus {
  active
  past_due
  canceled
  expired
  pending
}

enum PaymentProvider {
  stripe
  paypal
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  email               String   @unique
  emailVerifiedAt     DateTime?
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  role                Role     @default(student)
  status              UserStatus @default(active)
  locale              String   @default("fr")
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  userProgress            UserProgress[]
  bookmarks               Bookmark[]
  userAnswers             UserAnswer[]
  exerciseResults         ExerciseResult[]
  projectSubmissions      ProjectSubmission[]
  projectReviews          ProjectReview[]
  projectComments         ProjectComment[]
  certificates            Certificate[]
  userSubscription        UserSubscription?
  payments                Payment[]
  streaks                 Streak?
  achievements            Achievement[]
  userActivities          UserActivity[]
  notifications           Notification[]
  pushTokens              PushToken[]
  posts                   Post[]
  comments                Comment[]
  likes                   Like[]
  auditLogs               AuditLog[]
  authoredCourses         Course[]    @relation("CourseAuthor")

  @@map("User")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  deviceInfo String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("RefreshToken")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("EmailVerificationToken")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("PasswordResetToken")
}

model Domain {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String
  icon        String
  colorTheme  String
  order       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  technologies Technology[]

  @@map("Domain")
}

model Technology {
  id            String   @id @default(uuid()) @db.Uuid
  domainId      String   @db.Uuid
  slug          String   @unique
  name          String
  icon          String
  description   String
  order         Int
  isPremiumOnly Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  domain       Domain        @relation(fields: [domainId], references: [id])
  courses      Course[]
  certificates Certificate[]

  @@index([domainId])
  @@map("Technology")
}

model Course {
  id                   String   @id @default(uuid()) @db.Uuid
  technologyId         String   @db.Uuid
  title                String
  description          String
  level                Level    @default(beginner)
  estimatedDurationMin Int
  isPublished          Boolean  @default(false)
  authorId             String   @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  technology Technology @relation(fields: [technologyId], references: [id])
  author     User       @relation("CourseAuthor", fields: [authorId], references: [id])
  lessons    Lesson[]
  projects   Project[]

  @@index([technologyId])
  @@map("Course")
}

model Lesson {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @db.Uuid
  title            String
  contentMarkdown  String
  order            Int
  durationMin      Int
  videoUrl         String?
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course       Course          @relation(fields: [courseId], references: [id])
  userProgress UserProgress[]
  bookmarks    Bookmark[]
  exercises    Exercise[]

  @@index([courseId])
  @@map("Lesson")
}

model UserProgress {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  lessonId    String         @db.Uuid
  status      ProgressStatus @default(not_started)
  completedAt DateTime?
  timeSpentSec Int           @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("UserProgress")
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  lessonId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("Bookmark")
}

model Exercise {
  id                 String   @id @default(uuid()) @db.Uuid
  lessonId           String   @db.Uuid
  title              String
  passingScorePercent Int     @default(70)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lesson          Lesson           @relation(fields: [lessonId], references: [id])
  questions       Question[]
  exerciseResults ExerciseResult[]

  @@index([lessonId])
  @@map("Exercise")
}

model Question {
  id          String       @id @default(uuid()) @db.Uuid
  exerciseId  String       @db.Uuid
  type        QuestionType
  prompt      String
  explanation String
  order       Int
  points      Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  answerOptions AnswerOption[]
  userAnswers   UserAnswer[]

  @@index([exerciseId])
  @@map("Question")
}

model AnswerOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  label      String
  isCorrect  Boolean
  order      Int

  question Question @relation(fields: [questionId], references: [id])

  @@index([questionId])
  @@map("AnswerOption")
}

model UserAnswer {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  questionId       String    @db.Uuid
  selectedOptionId String?   @db.Uuid
  textAnswer       String?
  isCorrect        Boolean
  answeredAt       DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@index([userId, questionId])
  @@map("UserAnswer")
}

model ExerciseResult {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  exerciseId    String   @db.Uuid
  scorePercent  Int
  passed        Boolean
  attemptNumber Int
  completedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([userId, exerciseId])
  @@map("ExerciseResult")
}

model Project {
  id                 String   @id @default(uuid()) @db.Uuid
  courseId           String   @db.Uuid
  title              String
  instructions       String
  evaluationCriteria String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course      Course              @relation(fields: [courseId], references: [id])
  submissions ProjectSubmission[]

  @@index([courseId])
  @@map("Project")
}

model ProjectSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @db.Uuid
  userId       String           @db.Uuid
  repositoryUrl String?
  fileUrl      String?
  status       SubmissionStatus @default(submitted)
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project  Project          @relation(fields: [projectId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  reviews  ProjectReview[]
  comments ProjectComment[]

  @@index([projectId])
  @@index([userId])
  @@map("ProjectSubmission")
}

model ProjectReview {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @db.Uuid
  reviewerId   String   @db.Uuid
  score        Int
  feedback     String
  reviewedAt   DateTime @default(now())

  submission ProjectSubmission @relation(fields: [submissionId], references: [id])
  reviewer   User              @relation(fields: [reviewerId], references: [id])

  @@index([submissionId])
  @@map("ProjectReview")
}

model ProjectComment {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @db.Uuid
  authorId     String   @db.Uuid
  content      String
  createdAt    DateTime @default(now())

  submission ProjectSubmission @relation(fields: [submissionId], references: [id])
  author     User              @relation(fields: [authorId], references: [id])

  @@index([submissionId])
  @@map("ProjectComment")
}

model Certificate {
  id                String    @id @default(uuid()) @db.Uuid
  certificateNumber String    @unique
  userId            String    @db.Uuid
  technologyId      String    @db.Uuid
  scorePercent      Int
  issuedAt          DateTime  @default(now())
  pdfUrl            String?
  qrCodeData        String
  isRevoked         Boolean   @default(false)
  revokedReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user        User                    @relation(fields: [userId], references: [id])
  technology  Technology              @relation(fields: [technologyId], references: [id])
  verifications CertificateVerification[]

  @@index([certificateNumber])
  @@map("Certificate")
}

model CertificateVerification {
  id            String   @id @default(uuid()) @db.Uuid
  certificateId String   @db.Uuid
  verifiedAt    DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  certificate Certificate @relation(fields: [certificateId], references: [id])

  @@index([certificateId])
  @@map("CertificateVerification")
}

model SubscriptionPlan {
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique
  name            String
  priceMad        Decimal         @db.Decimal(10, 2)
  billingInterval BillingInterval
  features        Json
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  userSubscriptions UserSubscription[]

  @@map("SubscriptionPlan")
}

model UserSubscription {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @unique @db.Uuid
  planId                String          @db.Uuid
  status                SubStatus       @default(active)
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean         @default(false)
  paymentProvider       PaymentProvider
  providerSubscriptionId String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
  @@map("UserSubscription")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  subscriptionId    String?       @db.Uuid
  amountMad         Decimal       @db.Decimal(10, 2)
  currency          String        @default("MAD")
  status            PaymentStatus @default(pending)
  provider          PaymentProvider
  providerPaymentId String
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id])
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id])
  invoices     Invoice[]

  @@index([idempotencyKey])
  @@map("Payment")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @db.Uuid
  invoiceNumber String   @unique
  pdfUrl        String?
  issuedAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("Invoice")
}

model Streak {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActivityDate DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("Streak")
}

model Achievement {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  code        String
  title       String
  description String?
  unlockedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("Achievement")
}

model UserActivity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("UserActivity")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("Notification")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@map("PushToken")
}

model EmailQueue {
  id        String   @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  htmlBody  String
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@map("EmailQueue")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]

  @@index([authorId])
  @@map("Post")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([postId])
  @@map("Comment")
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("Like")
}

model Leaderboard {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  score     Int      @default(0)
  period    String
  rank      Int?
  updatedAt DateTime @updatedAt

  @@index([period, rank])
  @@map("Leaderboard")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?  @db.Uuid
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@map("AuditLog")
}

model UserEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  event     String
  properties Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@map("UserEvent")
}

model DailyStats {
  id         String   @id @default(uuid()) @db.Uuid
  date       DateTime
  metric     String
  value      Int
  createdAt  DateTime @default(now())

  @@unique([date, metric])
  @@map("DailyStats")
}

model CourseAnalytics {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  metric    String
  value     Int
  date      DateTime
  createdAt DateTime @default(now())

  @@index([courseId, metric, date])
  @@map("CourseAnalytics")
}
