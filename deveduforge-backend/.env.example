# ── Application ──
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
APP_VERSION=1.0.0
LOG_LEVEL=debug

# ── Base de données ──
DATABASE_URL=postgresql://user:1234localhost:5432/deveduforge?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ── Redis ──
REDIS_URL=redis://default:password@localhost:6379
REDIS_TLS=false

# ── JWT & Sessions ──
JWT_ACCESS_SECRET=change-me-access-secret-min-256-bits
JWT_REFRESH_SECRET=change-me-refresh-secret-min-256-bits
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=deveduforge.ma
JWT_ALGORITHM=HS256

# ── Mots de passe ──
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ── Stockage fichiers ──
STORAGE_ENDPOINT=https://s3.fr-par.io.cloud.ovh.net
STORAGE_REGION=fr-par
STORAGE_BUCKET=deveduforge-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_MAX_FILE_SIZE_MB=10

# ── Emails ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="DevEduForge <no-reply@deveduforge.ma>"

# ── Paiements ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_API_URL=

# ── Notifications push ──
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ── Certificats / QR ──
CERTIFICATE_QR_SIGNING_SECRET=change-me-qr-signing-secret
CERTIFICATE_VERIFY_BASE_URL=http://localhost:4000

# ── Monitoring ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Sécurité applicative ──
COOKIE_SECRET=change-me-cookie-secret
ENCRYPTION_KEY=change-me-encryption-key-32-chars
ALLOWED_FILE_TYPES=image/png,image/jpeg,application/pdf
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15
